diff --git a/platforms/win32/src/win32/kernel32_file.cpp b/platforms/win32/src/win32/kernel32_file.cpp
index e5c3fd3..12e4088 100644
--- a/platforms/win32/src/win32/kernel32_file.cpp
+++ b/platforms/win32/src/win32/kernel32_file.cpp
@@ -136,6 +136,25 @@ std::string GuestCurrentDir() {
   return g_cwd.empty() ? GuestGameDir() : g_cwd;
 }
 
+bool SetGuestCurrentDir(const std::string& guest_dir) {
+  std::string abs = AbsGuest(guest_dir);
+  bool ok = false;
+  struct stat st;
+  for (const auto& hd : HostDirs(abs)) {
+    if (stat(hd.c_str(), &st) == 0 && S_ISDIR(st.st_mode)) {
+      ok = true;
+      break;
+    }
+  }
+  if (!ok) {
+    hle::SetLastError(2);  // ERROR_FILE_NOT_FOUND
+    return false;
+  }
+  std::lock_guard<std::mutex> l(g_cwd_mu);
+  g_cwd = std::move(abs);
+  return true;
+}
